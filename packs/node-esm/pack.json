{
  "name": "node-esm",
  "version": "1.1.0",
  "description": "Node.js ESM code with no compiler: ESM, .mjs and Node-version rules, node --check as the syntax check, node --test notes.",
  "kind": "stack",
  "requires": ["core"],
  "conflicts": [],
  "detect": {
    "files": ["**/*.mjs"],
    "package_deps": [],
    "ask": null
  },
  "facts": [],
  "files": [
    {"src": "pack.md", "dest": ".claude/packs/node-esm.md"},
    {"src": "rules/node-esm.md", "dest": ".claude/rules/node-esm.md"}
  ],
  "hooks": [],
  "permissions": {"allow": ["Bash(npm audit --omit=dev --json)", "Bash(pnpm audit --prod --json)", "Bash(yarn audit --groups dependencies --json)", "Bash(yarn npm audit --all --recursive --environment production --json)"], "deny": ["Bash(npm audit fix*)", "Bash(npm audit * fix*)", "Bash(npm * audit fix*)", "Bash(npm * audit * fix*)", "Bash(pnpm audit --fix*)", "Bash(pnpm audit * --fix*)", "Bash(pnpm * audit * --fix*)", "Bash(pnpm * audit --fix*)", "Bash(pnpm audit * --ignore*)", "Bash(pnpm * audit * --ignore*)", "Bash(yarn npm audit * --fix*)"]},
  "mcp": {},
  "env": [],
  "third_party": [],
  "ci": []
}
