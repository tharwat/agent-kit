{
  "name": "statusline",
  "version": "1.0.0",
  "description": "Opt-in extra: a Claude Code status line showing model, branch, ticket and how much of the context window is used.",
  "kind": "extra",
  "requires": ["core"],
  "conflicts": [],
  "detect": {
    "files": [],
    "package_deps": [],
    "ask": "Show a status line with model, branch, ticket and context use?"
  },
  "facts": [],
  "files": [
    {"src": "pack.md", "dest": ".claude/packs/statusline.md"},
    {"src": "scripts/statusline.py", "dest": ".claude/scripts/statusline.py"}
  ],
  "hooks": [],
  "permissions": {"allow": [], "deny": []},
  "settings": {
    "statusLine": {
      "type": "command",
      "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"/.claude/scripts/statusline.py",
      "padding": 0
    }
  },
  "mcp": {},
  "env": [],
  "third_party": [],
  "ci": []
}
