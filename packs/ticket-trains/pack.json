{
  "name": "ticket-trains",
  "version": "1.0.0",
  "description": "Queue several triaged tickets and run them unattended, one at a time, with locked and validated state.",
  "kind": "workflow",
  "requires": [
    "core"
  ],
  "conflicts": [],
  "detect": {
    "files": [],
    "package_deps": [],
