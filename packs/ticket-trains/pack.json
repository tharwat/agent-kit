  },
  "facts": [],
  "files": [
    {
      "src": "pack.md",
      "dest": ".claude/packs/ticket-trains.md"
    },
    {
      "src": "commands/ticket-train-create.md",
      "dest": ".claude/commands/ticket-train-create.md"
    },
    {
      "src": "commands/ticket-train-triage.md",
      "dest": ".claude/commands/ticket-train-triage.md"
    },
    {
      "src": "commands/ticket-train-run.md",
      "dest": ".claude/commands/ticket-train-run.md"
    },
    {
      "src": "commands/ticket-train-status.md",
      "dest": ".claude/commands/ticket-train-status.md"
    },
    {
      "src": "scripts/train-state.mjs",
      "dest": ".claude/scripts/train-state.mjs"
    },
    {
      "src": "scripts/train-state.test.mjs",
      "dest": ".claude/scripts/train-state.test.mjs"
    }
  ],
  "hooks": [],
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/train-state.mjs *)"
