{
  "name": "fal-media",
  "version": "2.0.0",
  "description": "Opt-in extra: fal.ai's general-purpose media skills (image, video and audio generation, prompting, model catalog, workflows) and the genmedia CLI skill they run on, installed from GitHub at a pinned commit.",
  "kind": "extra",
  "requires": [
    "core"
  ],
  "conflicts": [],
  "detect": {
    "files": [],
    "package_deps": [],
    "ask": "Install the fal.ai media skills (generate images, video and audio through fal.ai)? They are third-party and need a fal.ai key and the genmedia CLI."
  },
  "facts": [],
  "files": [
    {
      "src": "pack.md",
      "dest": ".claude/packs/fal-media.md"
    }
  ],
  "hooks": [],
  "permissions": {
    "allow": [],
    "deny": []
  },
  "owner_tasks": [
    {"task": "Install the genmedia CLI (see the genmedia skill)", "why": "every skill except fal-media runs through it"},
    {"task": "Optional: connect a fal MCP server", "why": "only the fal-media skill uses one; without it the agent uses genmedia"}
  ],
  "mcp": {},
  "env": [
    {
      "name": "FAL_KEY",
      "purpose": "Authenticates every fal.ai call the skills make. Calls are billed to the key's account.",
      "how_to_get": "Create a key in the fal.ai dashboard (Keys page). Set it in the environment or the project's .env, or store it with `genmedia setup`. Never put it on a command line."
    }
  ],
