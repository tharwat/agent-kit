{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(diff *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(git remote get-url *)",
      "Bash(node .claude/scripts/kit-tools.mjs *)",
      "Bash(python3 .github/scripts/check_skill_links.py *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-branch.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
